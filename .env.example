# KisanSaathi environment variables.
# Copy this file to `.env` for local development and fill in your own values.
# NEVER put real secrets in this file and NEVER commit `.env`.
# Settings are read from the process environment; the application does not
# parse `.env` files automatically.

# Application environment: development | test | production
KISANSAATHI_ENV=development

# Default UI language: en | hi
KISANSAATHI_DEFAULT_LANGUAGE=en

# Retrieval models (download on first use; both default to BGE models)
KISANSAATHI_EMBEDDING_MODEL_NAME=BAAI/bge-m3
KISANSAATHI_RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
KISANSAATHI_EMBEDDING_DIMENSION=1024

# Local derived indexes (absolute paths are recommended for deployment;
# relative paths resolve against the process working directory)
KISANSAATHI_QDRANT_STORAGE_PATH=data/qdrant
KISANSAATHI_QDRANT_COLLECTION_NAME=kisansathi_chunks
KISANSAATHI_BM25_STORAGE_PATH=data/bm25.sqlite3

# Source manifest used for citations (defaults to data/sources.json in the
# repository checkout; override in deployment when the layout differs)
KISANSAATHI_SOURCES_MANIFEST=data/sources.json

# Vision provider: fake | gemini (fake is the safe default)
KISANSAATHI_VISION_PROVIDER=fake
# REQUIRED for the real Gemini provider. Keep it out of logs and never commit.
KISANSAATHI_VISION_API_KEY=
KISANSAATHI_VISION_MODEL_NAME=gemini-1.5-flash-latest
KISANSAATHI_VISION_TIMEOUT_SECONDS=15.0
KISANSAATHI_VISION_CONNECT_TIMEOUT_SECONDS=5.0
KISANSAATHI_VISION_MAX_RETRIES=2
KISANSAATHI_VISION_RETRY_BACKOFF_BASE=1.0
KISANSAATHI_VISION_MAX_IMAGE_BYTES=10485760
KISANSAATHI_VISION_TEMPERATURE=0.0
KISANSAATHI_VISION_MAX_OUTPUT_TOKENS=1024

# Answer generation (LLM) provider: fake | gemini (fake is the safe default).
# With no API key the application keeps its deterministic safe-failure
# responses; it never silently substitutes a fake answer generator.
KISANSAATHI_LLM_PROVIDER=fake
# REQUIRED for the real Gemini text provider. Keep it out of logs and never commit.
KISANSAATHI_LLM_API_KEY=
KISANSAATHI_LLM_MODEL_NAME=gemini-3.5-flash-lite
KISANSAATHI_LLM_TIMEOUT_SECONDS=15.0
KISANSAATHI_LLM_CONNECT_TIMEOUT_SECONDS=5.0
KISANSAATHI_LLM_MAX_RETRIES=2
KISANSAATHI_LLM_TEMPERATURE=0.0
KISANSAATHI_LLM_MAX_TOKENS=512

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
KISANSAATHI_LOG_LEVEL=INFO